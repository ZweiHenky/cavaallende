{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android":{
        "buildType":"apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "android":{
        "buildType":"apk"
      },
      "environment":"preview"
    }
  },
  "submit": {
    "production": {},
    "preview": {}
  }
}
