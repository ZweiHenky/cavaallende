{
  "expo": {
    "name": "cavaAllende",
    "slug": "cavaAllende",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/vino.png",
    "scheme": "cavaallende",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/vino.png",
        "backgroundImage": "./assets/vino.png",
        "monochromeImage": "./assets/vino.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ronnhy7.cavaAllende"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/vino.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/vino.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06cd107c-d86c-45ce-b08f-daf5af339f29"
      }
    }
  }
}
